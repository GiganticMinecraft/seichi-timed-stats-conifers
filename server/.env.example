DB_CONNECTION_HOST_AND_PORT=127.0.0.1:3306
DB_CONNECTION_USER=mariadb
DB_CONNECTION_PASSWORD=password
DB_CONNECTION_DATABASE=seichi_timed_stats_conifers
DB_CONNECTION_POOL_SIZE=3

RUST_BACKTRACE=1
RUST_LOG=debug,h2::codec::framed_read=info

SENTRY_ENVIRONMENT_NAME=local

# OpenTelemetry (traces + metrics) を OTLP HTTP で送る場合だけ設定する。
# OTEL_EXPORTER_OTLP_ENDPOINT が無ければ OTel は無効で、stdout の JSON ログだけになる
# OTEL_SERVICE_NAME=seichi-timed-stats-conifers-ingestor
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
