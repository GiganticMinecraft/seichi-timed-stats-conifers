# syntax=docker/dockerfile:1
# base の digest ピンはビルド入力の固定のため (更新は Renovate が追従)。
# Rust のバージョンは /rust-toolchain.toml と、Debian の世代は runtime (cc-debian13) と揃えること
FROM lukemathwalker/cargo-chef:0.1.78-rust-1.99.1-trixie@sha256:cccf15fc75944521a3aa230fe72a101ee0edc65cd1d4b50b5914ce25317c1805 AS chef
WORKDIR /app

FROM chef AS planner
COPY --link . .
RUN cargo chef prepare --recipe-path recipe.json

FROM bufbuild/buf:1.74.0 AS buf

FROM chef AS build-env
COPY --from=buf --link /usr/local/bin/buf /usr/local/bin/

# We need protoc because cargo chef cook will require it to build some modules (e.g. pbjson-types)
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*

# protoc plugins used by `buf generate` (see infra/upstream_repository_impl/buf.gen.yaml);
# versions are pinned in install-buf-plugins.sh
COPY --link install-buf-plugins.sh ./
RUN ./install-buf-plugins.sh

COPY --from=planner --link /app/recipe.json recipe.json

# Build dependencies - this is the caching Docker layer!
# 依存のビルド結果はレイヤー (CI では cache-to type=gha) に残す必要があるので cache mount は使わない
# (cache mount の中身はレイヤーにもリモートキャッシュにも残らない)
RUN cargo chef cook --release --locked --recipe-path recipe.json

# Build application
COPY --link . .
RUN cargo build --release --locked --bin seichi-timed-stats-conifers-ingestor

# 非 root (uid/gid 65532) で動かす。ingestor は rustls と純 Rust の mysql_async /
# miniz_oxide を使い、cc イメージ (glibc / libgcc_s / libssl) 以外の共有ライブラリを必要としない
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:b7e81cb1af38d9345680e68bcf564d388f96304e25222030fc8c051faf8565b3
LABEL org.opencontainers.image.source=https://github.com/GiganticMinecraft/seichi-timed-stats-conifers
COPY --from=build-env --link /app/target/release/seichi-timed-stats-conifers-ingestor /
USER 65532:65532
CMD ["/seichi-timed-stats-conifers-ingestor"]
