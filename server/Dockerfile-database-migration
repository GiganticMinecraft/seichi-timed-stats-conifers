# syntax=docker/dockerfile:1
# migration は純 Rust の database-migrator (diesel-async/mysql_async) で実行する。
# libmysqlclient (C) への動的リンクを持たないため、OS パッケージ側の
# クライアントライブラリのリグレッション (2026-08-02 インシデント、
# diesel-rs/diesel#5102) の影響を構造的に受けない (conifers#201)。
# base の digest ピンはビルド入力の固定のため (更新は Renovate が追従)
FROM rust:1.99.0-slim-trixie@sha256:01dd4f9c24801cfc8ba9cf8a5dd6dcca451cd17d1ae73574edc22591de6e6816 AS build
WORKDIR /build
# ビルド入力はこの 2 ディレクトリのみ (migrations SQL はコンパイル時に
# embed_migrations! でバイナリへ埋め込まれる)
COPY --link database-migrator ./database-migrator
COPY --link database/migrations ./database/migrations
# --locked でコミット済み Cargo.lock を強制する
RUN cargo build --release --locked --manifest-path database-migrator/Cargo.toml

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
LABEL org.opencontainers.image.source=https://github.com/GiganticMinecraft/seichi-timed-stats-conifers
COPY --from=build --link /build/database-migrator/target/release/database-migrator /
# DB の接続情報は実行時に環境変数で渡す (すべて必須):
#   DB_HOST_AND_PORT / DB_USER / DB_PASSWORD / DB_DATABASE_NAME
CMD ["/database-migrator"]
